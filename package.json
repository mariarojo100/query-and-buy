{
  "name": "query-and-buy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "mobile"
  ],
  "description": "Query & Buy — Next.js 15 web app on self-managed PostgreSQL",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "check:boundaries": "node scripts/check-db-boundaries.mjs",
    "test:unit": "node --import tsx tests/unit/run.ts",
    "test:authz": "node --import tsx tests/authz/run.ts",
    "test:api": "node --import tsx tests/api/run.ts",
    "test:verification": "node --import tsx tests/verification/run.ts",
    "audit:contact": "node --env-file=.env.local --import tsx scripts/audit-contact-info.ts",
    "diff:schema": "node --env-file=.env.local --import tsx scripts/diff-schema.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1080.0",
    "@aws-sdk/s3-request-presigner": "^3.1080.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@qb/shared": "*",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo-server-sdk": "^6.1.0",
    "jose": "^5.9.6",
    "lucide-react": "^1.21.0",
    "next": "^15",
    "next-auth": "^5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.0",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "nativewind": {
      "tailwindcss": "^3.4.19"
    }
  }
}