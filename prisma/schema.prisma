// Admin ops (110026), engagement logs (110027–110029)
// ---------------------------------------------------------------------------

model AdminAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId    String?  @map("admin_id") @db.Uuid
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  detail     Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  admin Profile? @relation(fields: [adminId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "idx_audit_created")
  @@map("admin_audit_log")
}

model AiModerationLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId     String?  @map("listing_id") @db.Uuid
  source        String   @default("listing")
  decision      String
  confidence    Decimal? @db.Decimal
  reason        String?
  humanOverride String?  @map("human_override")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  listing Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "idx_ai_mod_created")
  @@map("ai_moderation_log")
}

/// Singleton row (id = 'global', CHECK settings_singleton in SQL).
model MarketplaceSetting {
  id                   String   @id @default("global")
  marketplaceName      String   @default("Query & Buy") @map("marketplace_name")
  logoUrl              String?  @map("logo_url")
  brandColors          Json     @default("{}") @map("brand_colors")
  contactEmail         String?  @map("contact_email")
  supportEmail         String?  @default("support@queryandbuy.ae") @map("support_email")
  socialLinks          Json     @default("{}") @map("social_links")
  termsUrl             String?  @map("terms_url")
  privacyUrl           String?  @map("privacy_url")
  aiSettings           Json     @default("{}") @map("ai_settings")
  moderationThresholds Json     @default("{\"min_confidence\": 70}") @map("moderation_thresholds")
  maintenanceMode      Boolean  @default(false) @map("maintenance_mode")
  updatedAt            DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("marketplace_settings")
}

model ListingView {
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  viewedAt  DateTime @default(now()) @map("viewed_at") @db.Timestamptz(6)

  user    Profile @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, listingId])
  @@index([userId, viewedAt(sort: Desc)], map: "idx_listing_views_user")
  @@map("listing_views")
}

/// Deny-all RLS today (service-role only). Expression index
/// idx_search_log_query_lower on lower(query) lives in SQL.
model SearchLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  query     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user Profile? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "idx_search_log_created")
  @@map("search_log")
}

/// CHECKs in SQL: kind IN ('bug','feature','general'); message length 1–2000.
model Feedback {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  kind      String
  message   String
  path      String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user Profile? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "idx_feedback_created")
  @@map("feedback")
}

// ---------------------------------------------------------------------------
// Target-stack auth tables (db/baseline/0002_auth_tables.sql). These do NOT
// exist in the live Supabase database — they replace Supabase Auth state
// (design: TARGET_ARCHITECTURE.md §3.1). CHECK type IN (...) is SQL-only.
// ---------------------------------------------------------------------------

/// Email/password credential, 1:0..1 with users. bcrypt hash (Supabase hashes
/// verify as-is). OAuth-only accounts have no row here.
model AuthCredential {
  userId       String   @id @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("auth_credentials")
}

/// Linked OAuth accounts (Auth.js "account", trimmed). Google provider_account_id = `sub`.
model AuthAccount {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "idx_auth_accounts_user")
  @@map("auth_accounts")
}

/// Single-use email-verify / password-reset tokens; only the SHA-256 hash is stored.
model AuthVerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, type], map: "idx_auth_tokens_user")
  @@map("auth_verification_tokens")
}

/// Phone OTP state for the Twilio-backed verification flow. One active row per user.
model AuthPhoneOtp {
  userId    String   @id @map("user_id") @db.Uuid
  phoneE164 String   @map("phone_e164")
  codeHash  String   @map("code_hash")
  attempts  Int      @default(0) @db.SmallInt
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("auth_phone_otps")
}

// --- Mobile API tables (db/migrations/0003_api_tables.sql) -------------------

/// Rotating refresh tokens for the mobile /api/v1 token flow (lib/api/tokens.ts).
/// Only the sha256 hash is stored; rotatedFromId links the rotation chain so
/// reuse of an already-rotated token revokes the whole chain (theft detection).
model RefreshToken {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  rotatedFromId String?   @map("rotated_from_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Expo push tokens per device (lib/notifications/push.ts). One row per token;
/// a user may have several devices, a token moves between users on re-login.
model PushToken {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  token      String   @unique
  platform   String
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@map("push_tokens")
}

/// User blocks (App Store UGC requirement): blocker no longer sees the blocked
/// user's conversations and neither can start new ones with the other
/// (filters in lib/db/messaging.ts).
model BlockedUser {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocked_users")
}
